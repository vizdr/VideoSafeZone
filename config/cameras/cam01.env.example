# Per-camera hardware settings for cam-01 (USB webcam) -> install as
# /etc/adapter/cameras/cam01.env (LAUNCH.md A9). OPTIONAL: with no file, the camera is
# found by detection and every setting below uses the default shown (tuned for the
# AVerMedia PW310). Read by adapter/bin/detect-hw.sh via camera-init.sh and
# publish-cam01.sh. KEY=VALUE only; environment variables override the file.

# Which camera. Leave both unset while only one USB camera is attached.
#CAM_MATCH=PW310                # substring of its /dev/v4l/by-id name
#CAM_DEVICE=/dev/v4l/by-id/...  # or pin the exact device (skips detection)

# Capture format requested from the camera (must be MJPG: the pipeline hardware-decodes it).
#CAPS=image/jpeg,width=1280,height=720,framerate=30/1

# camera-init.sh, applied in two passes: modes first (switch the automatics off), then the
# values those modes unlock. Names are the camera's own: v4l2-ctl -d <dev> --list-ctrls
#V4L2_MODE_CTRLS=auto_exposure=1,exposure_dynamic_framerate=0,white_balance_automatic=0,focus_automatic_continuous=0
#V4L2_VALUE_CTRLS=exposure_time_absolute=250,white_balance_temperature=4600,focus_absolute=120

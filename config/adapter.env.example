# Adapter deployment identity -> install as /etc/adapter/adapter.env (LAUNCH.md A7):
#   sudo install -D -m 644 config/adapter.env.example /etc/adapter/adapter.env
# Read by adapter/config.py (Python) and adapter/bin/adapter-config.sh (bash).
# KEY=VALUE only -- no spaces around '=', no 'export'. Nothing here is a secret; the
# device's only credential is its certificate in $VMS_HOME/certs/.
#
# Values below are this project's account (596633517506). For another account, look them
# up rather than guessing:
#   aws iot describe-endpoint --endpoint-type iot:CredentialProvider   -> IOT_CRED_ENDPOINT
#   aws iot describe-endpoint --endpoint-type iot:Data-ATS             -> IOT_DATA_ENDPOINT

AWS_REGION=eu-central-1
THING_NAME=adapter-01
IOT_ROLE_ALIAS=KVSAdapterRoleAlias
IOT_CRED_ENDPOINT=c38gt2us7mrsmf.credentials.iot.eu-central-1.amazonaws.com
IOT_DATA_ENDPOINT=a3dp4umq4qv6ul-ats.iot.eu-central-1.amazonaws.com
EVIDENCE_BUCKET=vms-demo-evidence-596633517506

# yes on adapter-01 only: stamp this Thing name as adapterId on registry rows that have none and
# that this Pi serves (DEALER-PANEL-PLAN.md D4, D12) -- the cameras registered before adapterId
# existed, and any a VMS card registers. Absent or anything else means no. A second Pi says no.
ADOPT_UNSTAMPED_ROWS=yes

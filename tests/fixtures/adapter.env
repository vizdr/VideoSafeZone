# A fake deployment identity for the tests (PYTEST.md, step 3). tests/conftest.py points
# ADAPTER_CONFIG here before any adapter module is imported, so config.py never reads the Pi's real
# /etc/adapter/adapter.env. Nothing here names a real account, Thing or endpoint: the endpoints use
# the reserved .invalid domain, which can't resolve.
AWS_REGION=eu-central-1
THING_NAME=test-thing
# As adapter-01's: rows without adapterId are this Pi's (camera_control.is_mine, D12). Tests of
# the other case set config.ADOPT_UNSTAMPED_ROWS themselves.
ADOPT_UNSTAMPED_ROWS=yes
IOT_ROLE_ALIAS=TestRoleAlias
IOT_CRED_ENDPOINT=credentials.iot.invalid
IOT_DATA_ENDPOINT=data.iot.invalid
EVIDENCE_BUCKET=test-evidence-bucket

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ThumbnailsUnderItsThing",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::vms-demo-evidence-596633517506/thumbs/${credentials-iot:ThingName}/*"
    },
    {
      "Sid": "OutageClipsUnderItsThing",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::vms-demo-evidence-596633517506/clips/*/${credentials-iot:ThingName}/*"
    }
  ]
}

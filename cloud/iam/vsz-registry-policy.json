{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TheCameraRowsOfTheCallingAdapter",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:Scan"],
      "Resource": "arn:aws:dynamodb:eu-central-1:596633517506:table/cameras"
    },
    {
      "Sid": "TheClipRowsOfItsCameras",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:eu-central-1:596633517506:table/clips"
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CountAndListCamerasForTheDealerPortal",
      "Effect": "Allow",
      "Action": "dynamodb:Scan",
      "Resource": "arn:aws:dynamodb:eu-central-1:596633517506:table/cameras"
    },
    {
      "Sid": "WhenEachCamerasLastThumbnailWasTaken",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::vms-demo-evidence-596633517506/thumbs/*"
    }
  ]
}

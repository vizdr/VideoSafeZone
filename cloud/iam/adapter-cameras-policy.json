{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AskTheAdapter",
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": "arn:aws:iot:eu-central-1:596633517506:topic/adapter/*/cmd"
    },
    {
      "Sid": "ReadWhatAScanFound",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:eu-central-1:596633517506:table/adapter-discovery"
    },
    {
      "Sid": "KeepAndReadCameraRequests",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:GetItem", "dynamodb:DeleteItem"],
      "Resource": "arn:aws:dynamodb:eu-central-1:596633517506:table/camera-requests"
    },
    {
      "Sid": "WhoseCameraItIs",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:eu-central-1:596633517506:table/cameras"
    }
  ]
}
